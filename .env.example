# Copier ce fichier en .env et adapter les valeurs avant tout déploiement.

# FLASK_ENV=development est le SEUL moyen d'autoriser des valeurs de secours pour les secrets
# (SECRET_KEY, mot de passe admin) — nécessaire en local. Ne JAMAIS définir cette variable en
# production : sans elle, le démarrage échoue si un secret n'est pas explicitement fourni,
# pour éviter de déployer accidentellement avec les identifiants par défaut visibles ici.
FLASK_ENV=development

# Clé de session Flask - à changer impérativement en production
SECRET_KEY=dev-csj-secret-key-change-me

# Base de données
# En développement local sans MySQL installé, laisser vide pour utiliser SQLite (fichier data/csj_dev.db).
# En production, utiliser MySQL, ex:
# DATABASE_URL=mysql+pymysql://csj_user:motdepasse@localhost:3306/csj_portail
DATABASE_URL=

FLASK_DEBUG=1
PORT=5000

# Compte SUPER_ADMIN créé automatiquement si aucun compte admin n'existe (seed_demo.py ou premier démarrage)
ADMIN_EMAIL=admin@csjerusalem.cd
ADMIN_MOT_DE_PASSE=ChangeMoi2026!

# Canal email des notifications (app/services/notifications.py).
# Laisser MAIL_SERVER vide pour désactiver l'envoi réel (les notifications restent visibles
# dans /notifications, seul l'envoi hors plateforme est sauté). Exemple avec Gmail SMTP :
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=1
#   MAIL_USERNAME=xxx@gmail.com
#   MAIL_PASSWORD=mot-de-passe-application
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=CS Jérusalem <no-reply@csjerusalem.cd>
